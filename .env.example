# ---- 站点 ----
# 本地: :80   生产: 你的域名(如 scada.example.com)，Caddy 会自动申请 HTTPS 证书
SITE_ADDRESS=:80

# ---- 镜像 (生产从 GHCR 拉取) ----
IMAGE_PREFIX=ghcr.io/your-github-user/ai-scada
IMAGE_TAG=latest

# ---- 数据库 ----
POSTGRES_USER=scada
POSTGRES_PASSWORD=change-me
POSTGRES_DB=scada

# ---- 构建加速 (国内开发机可选，留空则用官方源) ----
PIP_INDEX_URL=
NPM_REGISTRY=
