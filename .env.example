# ---- 站点 ----
# 本地: :80   生产: 你的域名(如 scada.example.com)，Caddy 会自动申请 HTTPS 证书
SITE_ADDRESS=:80

# ---- 镜像 (生产从 GHCR 拉取) ----
IMAGE_PREFIX=ghcr.io/your-github-user/ai-scada
IMAGE_TAG=latest

# ---- 数据库 ----
POSTGRES_USER=scada
POSTGRES_PASSWORD=change-me
POSTGRES_DB=scada

# ---- 认证 ----
# JWT 签名密钥：生产必须设置（openssl rand -hex 32）；留空则每次启动随机生成，重启后需重新登录
JWT_SECRET=
# 演示模式：启动时创建演示账号（张工/李工 调度员、王工 监护员、admin 管理员），登录框显示账号和口令
DEMO_MODE=true
DEMO_PASSWORD=scada@2024
# 演示环境自动复位（分钟）：定时恢复正常运行方式、摘牌、确认告警；有人操作时推迟到空闲 10 分钟后。0 关闭
AUTO_RESET_MIN=60

# ---- 仿真 ----
# 仿真时钟倍速：60 = 1 分钟走完 1 小时（演示时可看到完整日负荷曲线）
SIM_SPEED=60

# ---- 构建加速 (国内开发机可选，留空则用官方源) ----
PIP_INDEX_URL=
NPM_REGISTRY=

# 可选：事故简报由大模型撰写（不配置则只用规则模板）
ANTHROPIC_API_KEY=
BRIEF_MODEL=claude-opus-5-5
